rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incomingUserId() {
      return request.resource.data.userId;
    }

    function existingUserId() {
      return resource.data.userId;
    }

    match /captures/{captureId} {
      allow read: if isOwner(existingUserId());
      allow create: if isOwner(incomingUserId())
        && incomingUserId() is string
        && request.resource.data.reviewStatus == 'unreviewed';
      allow update: if isOwner(existingUserId());
      allow delete: if isOwner(existingUserId());
    }

    match /actions/{actionId} {
      allow read: if isOwner(existingUserId());
      allow create: if isOwner(incomingUserId());
      allow update: if isOwner(existingUserId());
      allow delete: if isOwner(existingUserId());
    }

    match /waitingOns/{waitingOnId} {
      allow get, list: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /assets/{assetId} {
      allow read: if isOwner(existingUserId());
      allow create: if isOwner(incomingUserId());
      allow update: if isOwner(existingUserId());
      allow delete: if isOwner(existingUserId());
    }

    match /decisions/{decisionId} {
      allow read: if isOwner(existingUserId());
      allow create: if isOwner(incomingUserId());
      allow update: if isOwner(existingUserId());
      allow delete: if isOwner(existingUserId());
    }

    // Written by Cloud Functions (admin SDK). Clients read only.
    match /reviewRuns/{runId} {
      allow read: if isOwner(existingUserId());
      allow write: if false;
    }

    match /aiUsage/{usageId} {
      allow read: if isSignedIn()
        && usageId.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}$');
      allow write: if false;
    }

    match /users/{userId}/integrations/{integrationId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.status in ['connected', 'error']
        && request.resource.data.scopes is list;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/settings/{settingsId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && settingsId == 'harlan'
        && request.resource.data.userId == userId
        && request.resource.data.debriefTime is string
        && request.resource.data.timezone == 'America/Halifax';
      allow delete: if isOwner(userId);
    }

    // Server-owned OAuth state and refresh tokens. Cloud Functions use Admin SDK.
    match /oauthStates/{stateId} {
      allow read, write: if false;
    }

    match /googleOAuthTokens/{userId} {
      allow read, write: if false;
    }
  }
}
