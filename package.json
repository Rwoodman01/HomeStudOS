{
  "name": "homestud-os-command-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "firebase:check": "firebase use && firebase apps:list --project homestud-os",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage --project homestud-os",
    "deploy:functions": "firebase deploy --only functions --project homestud-os",
    "deploy:hosting": "npm run build && firebase deploy --only hosting --project homestud-os",
    "deploy": "npm run build && firebase deploy --project homestud-os"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "fdir": "^6.5.0",
    "firebase": "^12.0.0",
    "lucide-react": "^0.475.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
